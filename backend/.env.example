# Copier ce fichier en .env et renseigner les vraies valeurs.
# Ne JAMAIS committer le fichier .env (déjà exclu par .gitignore).

# --- Base de données ---
DATABASE_URL="postgresql://user:password@localhost:5432/unique_livraison"

# --- JWT ---
# Générer des secrets robustes, par exemple : openssl rand -base64 48
JWT_SECRET="change-moi"
JWT_REFRESH_SECRET="change-moi-aussi"

# --- Serveur ---
PORT=3000

# --- Dashboard web ---
CORS_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"

# --- Firebase Cloud Messaging ---
# JSON compact ou chemin vers un fichier de compte de service gardé hors du dépôt.
# FCM_SERVICE_ACCOUNT_JSON='{"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n..."}'
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_PATH="./secrets/firebase-service-account.json"
